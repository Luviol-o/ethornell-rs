+    let name = file.replace('\\', "/");
+    if matches!(normalized.as_str(), "bgi-resource/" | "bgi-user/") {
+        if name.starts_with("bgi-") {
+            name.starts_with(&normalized).then_some(name)
+        } else {
+            Some(format!("{normalized}{name}"))
+        }
+    } else {
+        Some(name)
+    }
